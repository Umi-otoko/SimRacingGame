# =============================================================================
# SimRacingGame .gitignore
# =============================================================================

# Build output
build/
out/
bin/
lib/
*.obj
*.pdb
*.ilk
*.exp
*.lib

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt

# Visual Studio
.vs/
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Unreal Engine (cuando se integre el proyecto UE5)
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.idea/
*.uproject.bak
*.uasset
*.umap
# NO ignorar: Source/, Config/, Content/Blueprints/, Content/Maps/

# Steamworks SDK (no commitear — contiene binarios propietarios)
extern/steamworks_sdk/

# JoltPhysics extern (se clona via script de setup, no se commitea)
extern/JoltPhysics/

# Secretos — NUNCA commitear
*.env
.env.*
secrets.json
server_keys.json
*_key.pem
*_cert.pem
*.pfx
*.p12

# Setup files cifrados de prueba
*.vsetup

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Crash dumps
*.dmp
*.mdmp
